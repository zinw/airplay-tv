<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_dark">

    <!-- 1. Ambient / Idle Screen Container -->
    <LinearLayout
        android:id="@+id/ambientContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="48dp"
        android:gravity="center_vertical">

        <!-- Left: Branding and Connection Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/tv_accent"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ready_to_connect"
                android:textColor="@color/tv_text_primary"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/connect_instruction"
                android:textColor="@color/tv_text_secondary"
                android:textSize="16sp" />

            <!-- Device Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/server_name_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvServerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Android TV AirPlay"
                        android:textColor="@color/tv_accent"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ip_address_label"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvIpAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="192.168.1.100:7000"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Control Buttons (D-Pad Focusable) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_focusable"
                    android:focusable="true"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:text="@string/settings_title"
                    android:textColor="@color/tv_text_primary" />

            </LinearLayout>

        </LinearLayout>

        <!-- Right: QR Code & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Status: Broadcasting (mDNS active)"
                android:textColor="@color/tv_accent"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- 2. Video Mirroring View Container (SurfaceView with AspectRatio) -->
    <io.github.jqssun.airplay.video.AspectFrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="gone">

        <SurfaceView
            android:id="@+id/surfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </io.github.jqssun.airplay.video.AspectFrameLayout>

    <!-- 3. HLS Web Video View Container (Media3 ExoPlayer) -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/hlsPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:use_controller="true" />

    <!-- 4. Audio-Only Music Player UI Container -->
    <LinearLayout
        android:id="@+id/musicContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivCoverArt"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="@drawable/bg_card"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Track Title"
            android:textColor="@color/tv_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrackArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Artist Name - Album"
            android:textColor="@color/tv_text_secondary"
            android:textSize="20sp" />

        <io.github.jqssun.airplay.ui.view.VisualizerView
            android:id="@+id/visualizerView"
            android:layout_width="400dp"
            android:layout_height="80dp"
            android:layout_marginTop="32dp" />

    </LinearLayout>

    <!-- 5. Performance HUD Overlay (Top-Right) -->
    <LinearLayout
        android:id="@+id/hudOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_hud"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvHudStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="1080p60 | H.264\nBitrate: 8.5 Mbps\nLatency: 28 ms\nDropped: 0"
            android:textColor="@color/tv_accent"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 6. AirPlay PIN Code Dialog Overlay -->
    <LinearLayout
        android:id="@+id/pinOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="36dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_code_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/pin_code_bg"
            android:letterSpacing="0.4"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:text="1234"
            android:textColor="@color/tv_accent"
            android:textSize="42sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
