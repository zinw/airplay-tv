<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/tv_focus_fill" />
            <stroke
                android:width="2.5dp"
                android:color="@color/tv_accent_warm" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/tv_focus_fill" />
            <stroke
                android:width="2dp"
                android:color="@color/tv_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/tv_status_neutral_bg" />
            <stroke
                android:width="1.5dp"
                android:color="#66A8B8C4" />
        </shape>
    </item>
</selector>
