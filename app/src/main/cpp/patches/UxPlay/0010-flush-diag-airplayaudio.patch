 #define RAOP_BUFFER_LENGTH 256
 
@@ -113,6 +114,51 @@ seqnum_cmp(unsigned short s1, unsigned short s2)
     return (s1 - s2);
 }
 
+static int
+raop_buffer_entry_count(raop_buffer_t *raop_buffer)
+{
+    if (raop_buffer->is_empty) {
+        return 0;
+    }
+    return (int)seqnum_cmp(raop_buffer->last_seqnum, raop_buffer->first_seqnum) + 1;
+}
+
+static int
+raop_buffer_hole_at_head(raop_buffer_t *raop_buffer)
+{
+    int hole = 0;
+    unsigned short seqnum;
+    if (raop_buffer->is_empty) {
+        return 0;
+    }
+    for (seqnum = raop_buffer->first_seqnum;
+         seqnum_cmp(seqnum, raop_buffer->last_seqnum) <= 0;
+         seqnum++) {
+        raop_buffer_entry_t *entry = &raop_buffer->entries[seqnum % RAOP_BUFFER_LENGTH];
+        if (entry->filled && seqnum_cmp(entry->seqnum, seqnum) == 0) {
+            break;
+        }
+        hole++;
+        if (hole >= RAOP_BUFFER_LENGTH) {
+            break;
+        }
+    }
+    return hole;
+}
+
+void
+raop_buffer_diag_stats(raop_buffer_t *raop_buffer, int *is_empty,
+                       unsigned short *first_seq, unsigned short *last_seq,
+                       int *entry_count, int *hole_at_head)
+{
+    assert(raop_buffer);
+    if (is_empty) *is_empty = raop_buffer->is_empty;
+    if (first_seq) *first_seq = raop_buffer->first_seqnum;
+    if (last_seq) *last_seq = raop_buffer->last_seqnum;
+    if (entry_count) *entry_count = raop_buffer_entry_count(raop_buffer);
+    if (hole_at_head) *hole_at_head = raop_buffer_hole_at_head(raop_buffer);
+}
+
