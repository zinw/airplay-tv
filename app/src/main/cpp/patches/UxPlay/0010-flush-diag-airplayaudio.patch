         /* Check how much we have space left in the buffer */
         if (entry_count < RAOP_BUFFER_LENGTH) {
             /* Return nothing and hope resend gets on time */
+            {
+                int hole = raop_buffer_hole_at_head(raop_buffer);
+                audio_flush_diag_dequeue(0, raop_buffer->first_seqnum, 0, entry_count, hole, 1);
+            }
             return NULL;
         }
         /* Risk of buffer overrun, return empty buffer */
@@ -252,6 +304,7 @@ raop_buffer_dequeue(raop_buffer_t *raop_buffer, unsigned int *length, uint32_t *
     /* Update buffer and validate entry */
     raop_buffer->first_seqnum += 1;
     if (!entry->filled) {
+        audio_flush_diag_dequeue(0, (unsigned)(raop_buffer->first_seqnum - 1), 0, entry_count, 1, 0);
         return NULL;
     }
     entry->filled = 0;
@@ -263,6 +316,7 @@ raop_buffer_dequeue(raop_buffer_t *raop_buffer, unsigned int *length, uint32_t *
     entry->payload_size = 0;
     void* data = entry->payload_data;
     entry->payload_data = NULL;
+    audio_flush_diag_dequeue(1, *seqnum, *length, entry_count, 0, 0);
